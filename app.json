{
  "expo": {
    "name": "Hikari",
    "slug": "hikari",
    "scheme": "hikari",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hikari.editor.fabiosantos",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Hikari precisa acessar sua fototeca para editar suas fotos.",
        "NSPhotoLibraryAddUsageDescription": "Hikari salva suas fotos editadas na fototeca.",
        "UISupportsDocumentBrowser": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "LSApplicationQueriesSchemes": [
          "komorebi"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.br.dev.fabiosantos.komorebi.camera"
        ]
      },
      "appleTeamId": "77MXYLFJ7J"
    },
    "android": {
      "package": "app.hikari.editor",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      "expo-localization",
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "Hikari precisa acessar sua fototeca para editar suas fotos.",
          "savePhotosPermission": "Hikari salva suas fotos editadas na fototeca.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
